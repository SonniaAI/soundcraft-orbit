      collapsedHeight: 8.500000
      focalDistanceCm: !<float> 66.000000
      statusLineHeight: !<float> 7.000000
      inputRowHeight: 2.600000
      pairRowHeight: 3.400000
      titleText: COMPANION LINK
      pairButtonLabel: PAIR — LINK COMPANION
      endpointPlaceholder: "companion endpoint (https://…)"
      openButtonLabel: OPEN LAST SAVE
      openArmedLabel: TAP AGAIN — REPLACES LIVE DOC
      codePlaceholder: one-time pairing code…
      idleCompactText: WAITING — tap ▸ for connection details
